{
  "extends": "./tsconfig.json",
  "include": [
    "client/src/**/*.test.ts",
    "client/src/**/*.test.tsx",
    "client/src/**/*.spec.ts",
    "client/src/**/*.spec.tsx",
    "server/**/*.test.ts",
    "server/**/*.spec.ts",
    "shared/**/*.test.ts",
    "shared/**/*.spec.ts"
  ],
  "exclude": ["node_modules", "build", "dist"],
  "compilerOptions": {
    "incremental": false
  }
}
