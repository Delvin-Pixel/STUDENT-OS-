{
  "name": "student-os",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch server/_core/index.ts",
    "build": "vite build && esbuild server/_core/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist && esbuild server/vercelHandler.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/vercel.mjs",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "pnpm typecheck:app && pnpm typecheck:tests && pnpm typecheck:config",
    "lint": "eslint \"api/**/*.mjs\" \"client/src/**/*.{ts,tsx}\" \"server/**/*.ts\" \"shared/**/*.ts\" \"scripts/**/*.{js,mjs}\" client/public/sw.js vite.config.ts vitest.config.ts drizzle.config.ts --max-warnings=0",
    "format:check": "prettier . --check",
    "lint:audited": "pnpm check && pnpm lint && pnpm format:check && pnpm check:migrations && pnpm scan:credentials",
    "verify:secrets": "bash scripts/check-source-secrets.sh",
    "scan:credentials": "pnpm verify:secrets",
    "format": "prettier --write .",
    "test": "vitest run",
    "db:push": "pnpm db:migrate",
    "typecheck:app": "tsc -p tsconfig.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "typecheck:config": "tsc -p tsconfig.node.json --noEmit",
    "check:migrations": "node scripts/check-drizzle-metadata.mjs",
    "db:migrate": "drizzle-kit migrate",
    "verify:bundle": "node scripts/check-production-bundle.mjs",
    "verify:migration-schema": "node scripts/check-subscription-migration.mjs",
    "db:generate": "drizzle-kit generate"
  },
