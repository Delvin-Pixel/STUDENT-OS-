AI_GATEWAY_API_KEY=
DATABASE_URL=
RATE_LIMIT_SECRET=replace-with-a-random-secret-at-least-32-characters
# Required in production; keep private and rotate if exposed.
NEXA_DB_POOL_MAX=5
NEXA_DB_STATEMENT_TIMEOUT_MS=15000
# Optional Supabase TLS trust configuration. Keep strict verification by default.
# NEXA_DB_SSL_CA may contain the Supabase root CA PEM (literal newlines or \\n escapes).
NEXA_DB_SSL_CA=
# Preview-only escape hatch: encrypted TLS without CA/hostname verification.
# Leave false for production and prefer NEXA_DB_SSL_CA with sslmode=verify-full.
NEXA_DB_SSL_ALLOW_UNVERIFIED=false

NEXA_MODEL=openai/gpt-5.6-sol
NEXA_AI_TOTAL_TIMEOUT_MS=120000
NEXA_AI_STEP_TIMEOUT_MS=45000
NEXA_AI_CHUNK_TIMEOUT_MS=15000
NEXA_AI_MAX_RETRIES=1
NEXA_AI_GATEWAY_READINESS_TIMEOUT_MS=5000

# Optional semantic project-file retrieval. If unavailable, NEXA falls back to lexical search.
NEXA_EMBEDDING_MODEL=openai/text-embedding-3-small
NEXA_EMBEDDING_DIMENSIONS=512
NEXA_EMBEDDING_TIMEOUT_MS=12000
NEXA_EMBEDDING_MAX_RETRIES=1
NEXA_EMBEDDING_CHUNK_CHARS=6000
NEXA_EMBEDDING_MAX_CHUNKS=8

# First-class voice input. Audio is transcribed then discarded; only text enters chat persistence.
NEXA_TRANSCRIPTION_MODEL=google/gemini-3.5-transcribe
NEXA_TRANSCRIPTION_TIMEOUT_MS=45000
NEXA_TRANSCRIPTION_MAX_RETRIES=1

# Durable PDF/image project knowledge. Original bytes stay fenced; derived text feeds lexical/semantic retrieval.
NEXA_RICH_EXTRACTION_MODEL=openai/gpt-5.6-sol
NEXA_RICH_EXTRACTION_TIMEOUT_MS=90000
NEXA_RICH_EXTRACTION_MAX_RETRIES=1

# Deployment-only live capability diagnostics. Disabled by default; token must be 32+ chars.
NEXA_DIAGNOSTICS_ENABLED=false
NEXA_DIAGNOSTICS_TOKEN=
NEXA_DIAGNOSTICS_TIMEOUT_MS=20000

# Private server-to-server Student OS integration. Keep this secret off the browser/client.
NEXA_STUDENT_OS_BRIDGE_SECRET=
NEXA_STUDENT_OS_BRIDGE_TIMEOUT_MS=18000
NEXA_STUDENT_OS_BRIDGE_NEGOTIATION_REQUIRED=false
NEXA_STUDENT_OS_BRIDGE_GLOBAL_LIMIT_PER_MINUTE=300
NEXA_STUDENT_OS_BRIDGE_USER_LIMIT_PER_MINUTE=30
NEXA_STUDENT_OS_BRIDGE_USER_LIMIT_PER_HOUR=300
